{
  "name": "onworking",
  "version": "0.1.0",
  "description": "AI 数据工作的透明执行框架",
  "main": "dist/main/main/index.js",
  "scripts": {
    "start": "npm run build:main && concurrently -k \"npm run dev:renderer\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "preview": "npm run build && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev:renderer": "vite --port 5173 --strict-port",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@univerjs/core": "^0.25.1",
    "@univerjs/design": "^0.25.1",
    "@univerjs/engine-formula": "^0.25.1",
    "@univerjs/engine-render": "^0.25.1",
    "@univerjs/sheets": "^0.25.1",
    "@univerjs/sheets-formula": "^0.25.1",
    "@univerjs/sheets-ui": "^0.25.1",
    "@univerjs/ui": "^0.25.1",
    "better-sqlite3": "^11.0.0",
    "js-yaml": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  }
}
